  "energyAdjustments": [
    {
      "label": "Outras categorias de manutenção (Tabela 15-4)",
      "note": "kcal × PV^0,75: jovens adultos ativos 140; Grand Danois ativos 200; terriers ativos 180; cães idosos ou Terra-Nova 105."
    },
    {
      "label": "Gestação final, 4 semanas após cobrição até ao parto (Tabela 15-6)",
      "note": "EM (kcal) = 130 × PV^0,75 + 26 × PV. Exemplo NRC: cadela de 22 kg → 1320 + 572 = 1892 kcal."
    },
    {
      "label": "Lactação (Tabela 15-7)",
      "note": "EM (kcal) = 145 × PV^0,75 + PV × (24n + 12m) × L; n = crias de 1 a 4, m = crias de 5 a 8 (m = 0 se <5 crias); L = 0,75; 0,95; 1,1; 1,2 nas semanas 1–4. Exemplo NRC: 22 kg, 6 crias, semana 3 → 1473 + 2904 = 4377 kcal."
    },
    {
      "label": "Crescimento após o desmame (Tabela 15-2)",
      "note": "EM (kcal) = 130 × PVa^0,75 × 3,2 × [e^(−0,87·p) − 0,1], com p = PVa/PVm (peso atual/peso adulto esperado). Cachorros recém-nascidos: ~25 kcal/100 g PV."
    }
  ],
